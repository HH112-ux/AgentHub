# 页面标题
VITE_APP_TITLE = AgentHub
VITE_APP_LOGO_TITLE = AgentHub

# 生产环境配置
VITE_APP_ENV = 'production'

# 应用访问路径 例如使用前缀 /admin/
VITE_APP_CONTEXT_PATH = '/'

# 生产环境
VITE_APP_BASE_API = '/prod-api'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

VITE_APP_PORT = 80

# 接口加密功能开关(如需关闭 后端也必须对应关闭)
VITE_APP_ENCRYPT = true
# 接口加密传输 RSA 公钥与后端解密私钥对应；如更换需前后端一同更换。
# 公钥可进入浏览器产物；私钥属于服务端秘密，不得提交到仓库。生产环境应改为服务端解密。
VITE_APP_RSA_PUBLIC_KEY = 'REPLACE_WITH_RSA_PUBLIC_KEY'
# 接口响应解密 RSA 私钥与后端加密公钥对应；仅用于本地联调，生产环境应改为服务端解密。
VITE_APP_RSA_PRIVATE_KEY = 'REPLACE_WITH_RSA_PRIVATE_KEY'

# 客户端id
VITE_APP_CLIENT_ID = 'e5cd7e4891bf95d1d19206ce24a7b32e'

# 统一消息推送开关
VITE_APP_MESSAGE_ENABLED = true

# sse / websocket
VITE_APP_MESSAGE_TRANSPORT = 'sse'

# 统一消息推送路径
VITE_APP_MESSAGE_PATH = '/resource/message'
