# AgentHub PG 栈环境变量清单——复制为同目录 .env 后填值；.env 不入库（已在 .gitignore）。
# 命名口径：AgentHub 自有变量一律 AGENTHUB_* 大写蛇形（设计稿 §3.1）。
# POSTGRES_*、REDIS_PASSWORD、MILVUS_PASSWORD、MINIO_ROOT_* 是上游镜像固定读取的名字，无法加前缀，
# 属 §3.1 的例外；改名需同步三条线。
# 密钥一律不进仓：值只写在本机 .env 或密钥管理系统，镜像与 Compose 文件里不得出现真实口令。
# 变量如何抵达底座属性路径，见同目录 config/application-agenthub.yml 与 docs/configuration.md。

# ── 应用 ──────────────────────────────────────────────
# agenthub 必须排在 prod 之后，否则压不动底座的明文默认值。
AGENTHUB_SPRING_PROFILES_ACTIVE=prod,agenthub
AGENTHUB_TZ=Asia/Shanghai

# 模型密钥密文落库的根密钥（16/24/32 位）。命中出厂示例值即拒绝启动。
AGENTHUB_AI_CRYPTO_KEY=REPLACE_WITH_32_BYTE_ROOT_KEY
# MCP 出口访问口令；生产必须替换为强口令。
AGENTHUB_AI_MCP_SERVER_TOKEN=REPLACE_WITH_STRONG_MCP_TOKEN
# prod 下 warn 无效；本地调试可临时置 warn。
AGENTHUB_SECURITY_GUARD_MODE=enforce
AGENTHUB_AI_CHAT_CURRENT_TIME_ZONE=Asia/Shanghai

# JVM 现场调口，注入后端镜像的 JAVA_OPTS。留空＝JVM 按容器/宿主内存 25% 自行取堆。
# §11 建议的 16G 机器可留空；8G 单机常驻必须压住堆，给同一台机器上的 Milvus、etcd、MinIO 留余量。
# 口径与实测见 docs/configuration.md §7。
AGENTHUB_APP_JAVA_OPTS=-Xms512m -Xmx1200m

# 下面三组在生产环境必须换掉：底座把 RSA 公私钥、JWT 密钥、数据库口令以明文写死在
# application-prod.yml 里，不覆盖就等于带着仓库内私钥上线。
AGENTHUB_SA_TOKEN_JWT_SECRET_KEY=REPLACE_WITH_JWT_SECRET
AGENTHUB_API_DECRYPT_PUBLIC_KEY=REPLACE_WITH_RSA_PUBLIC_KEY
AGENTHUB_API_DECRYPT_PRIVATE_KEY=REPLACE_WITH_RSA_PRIVATE_KEY

# ── 数据源（映射到 spring.datasource.dynamic.datasource.master.*）──
# 默认值已在 compose 里按栈内 db 服务拼好，需追加连接参数时才在此整条覆写。
# AGENTHUB_DATASOURCE_URL=jdbc:postgresql://db:5432/agenthub?useUnicode=true&characterEncoding=utf8&useSSL=false&autoReconnect=true&reWriteBatchedInserts=true
AGENTHUB_REDIS_HOST=redis
AGENTHUB_REDIS_PORT=6379

# ── PostgreSQL（栈内 db 服务）──────────────────────────
POSTGRES_DB=agenthub
POSTGRES_USER=agenthub
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Redis / Milvus / etcd / MinIO ─────────────────────
# Redis 口令同时喂给 redis 服务的 requirepass 与应用侧，两处必须同值。
REDIS_PASSWORD=REPLACEPASSWORD
MILVUS_PASSWORD=REPLACEPASSWORD
MINIO_ROOT_USER=agenthub
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── 编排接线 ──────────────────────────────────────────
# 底座基线 SQL 已入仓库并由 compose 固定挂载（initdb 序号 10/11/12），不再由本文件提供路径。
# 后端镜像与 Dockerfile：B 线在 code/back-end 落 Dockerfile 后生效。
AGENTHUB_APP_IMAGE=agenthub/app:local
AGENTHUB_APP_DOCKERFILE=Dockerfile
# 前端构建产物目录（同源伺服，设计稿 §2.1）。
FRONTEND_DIST=../../code/front-end/dist
# HTTPS 证书目录，Nginx 内固定读 agenthub.crt / agenthub.key；证书文件不得入仓（§2.3.1）。
CERT_DIR=./cert
# 端口：本栈 80/443 与后端 8080；MySQL 栈用 81/8443 与 8081，两栈同机并存。
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
APP_HOST_PORT=8080
