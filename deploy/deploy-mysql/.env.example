# AgentHub MySQL 栈环境变量清单——复制为同目录 .env 后填值；.env 不入库（已在 .gitignore）。
# 与 PG 栈同机并存：本栈入口 81/8443、后端 8081；PG 栈 80/443、8080。
# 命名口径与例外说明见 deploy-pg/.env.example 头部；两栈的 .env 相互独立，可填不同口令。

# ── 应用 ──────────────────────────────────────────────
# agenthub 必须排在 prod 之后，否则压不动底座的明文默认值。
AGENTHUB_SPRING_PROFILES_ACTIVE=prod,agenthub
AGENTHUB_TZ=Asia/Shanghai

# 模型密钥密文落库的根密钥（16/24/32 位）。命中出厂示例值即拒绝启动。
AGENTHUB_AI_CRYPTO_KEY=REPLACE_WITH_32_BYTE_ROOT_KEY
# prod 下 warn 无效；本地调试可临时置 warn。
AGENTHUB_SECURITY_GUARD_MODE=prod
AGENTHUB_AI_CHAT_CURRENT_TIME_ZONE=Asia/Shanghai

# 下面三组在生产环境必须换掉：底座把 RSA 公私钥、JWT 密钥、数据库口令以明文写死在
# application-prod.yml 里，不覆盖就等于带着仓库内私钥上线。
AGENTHUB_SA_TOKEN_JWT_SECRET_KEY=REPLACE_WITH_JWT_SECRET
AGENTHUB_API_DECRYPT_PUBLIC_KEY=REPLACE_WITH_RSA_PUBLIC_KEY
AGENTHUB_API_DECRYPT_PRIVATE_KEY=REPLACE_WITH_RSA_PRIVATE_KEY

# ── 数据源（映射到 spring.datasource.dynamic.datasource.master.*）──
# 默认值已在 compose 里按栈内 db 服务拼好，需追加连接参数时才在此整条覆写。
# AGENTHUB_DATASOURCE_URL=jdbc:mysql://db:3306/agenthub?useUnicode=true&characterEncoding=utf8&serverTimezone=GMT%2B8&useSSL=false&allowPublicKeyRetrieval=true&autoReconnect=true&rewriteBatchedStatements=true
AGENTHUB_REDIS_HOST=redis
AGENTHUB_REDIS_PORT=6379

# ── MySQL（栈内 db 服务）──────────────────────────────
MYSQL_DATABASE=agenthub
MYSQL_USER=agenthub
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Redis / Milvus / etcd / MinIO ─────────────────────
REDIS_PASSWORD=REPLACEPASSWORD
MILVUS_PASSWORD=REPLACEPASSWORD
MINIO_ROOT_USER=agenthub
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── 编排接线 ──────────────────────────────────────────
# 底座基线 SQL 已入仓库并由 compose 固定挂载（initdb 序号 10/11/12），不再由本文件提供路径。
AGENTHUB_APP_IMAGE=agenthub/app-mysql:local
AGENTHUB_APP_DOCKERFILE=Dockerfile
FRONTEND_DIST=../../code/front-end/dist
# HTTPS 证书目录，Nginx 内固定读 agenthub.crt / agenthub.key；证书文件不得入仓（§2.3.1）。
CERT_DIR=./cert
# 端口：本栈 81/8443 与后端 8081，与 PG 栈同机不冲突。
WEB_HTTP_PORT=81
WEB_HTTPS_PORT=8443
APP_HOST_PORT=8081
